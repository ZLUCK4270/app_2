<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Visor de Cámara HUD -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra Superior Flotante -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_scanner_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_translucent"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Escaneo de Contenedor"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_scanner_torch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_translucent"
            android:src="@drawable/ic_flashlight"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Retícula y Láser Central -->
    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scanner_crosshair" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="@color/ecolim_accent_mint" />
    </FrameLayout>

    <!-- Panel Inferior de Detección -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_white"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_scanner_codigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esperando Captura..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ecolim_primary_dark" />

        <TextView
            android:id="@+id/tv_scanner_ia_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Presione capturar para analizar el residuo"
            android:textSize="13sp"
            android:textColor="@color/ecolim_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scanner_capturar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Capturar Imagen"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scanner_pesar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Continuar a Pesaje"
            android:backgroundTint="@color/ecolim_primary"
            app:cornerRadius="12dp"
            android:enabled="false" />
    </LinearLayout>

</FrameLayout>
