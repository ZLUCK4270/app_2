<?xml version="1.0" encoding="utf-8"?>
<!-- ==========================================================
     ECOLIM MÓVIL - SINCRONIZACIÓN Y DIAGNÓSTICO (fragment_sincronizar.xml)
     Cola local SQLite, Estado de Red 4G, Botón Sync y Exportación CSV
     ========================================================== -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ecolim_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tarjeta de Nodo Móvil y Conexión -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/ecolim_card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ecolim_divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_cloud_sync"
                        app:tint="@color/ecolim_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nodo_activo"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/ecolim_text_main" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Conectado a Servidor Python / SQLite"
                            android:textSize="12sp"
                            android:textColor="@color/ecolim_text_muted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_pendientes_contador_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_sync_pending"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="2 Pendientes"
                        android:textColor="@color/sync_pending_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botón de Sincronización Inmediata -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sincronizar_ahora"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_sincronizar_ahora"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@color/ecolim_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Diagnóstico de Base de Datos SQLite y Almacenamiento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="DIAGNÓSTICO DEL SISTEMA"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ecolim_text_muted" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/ecolim_card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ecolim_divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Almacenamiento Local SQLite"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/ecolim_text_main" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_sqlite_storage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:progress="6"
                    app:indicatorColor="@color/ecolim_primary"
                    app:trackColor="@color/ecolim_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1.2 MB ocupados de 50 MB asignados (v2.6)"
                    android:textSize="11sp"
                    android:textColor="@color/ecolim_text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones de Exportación CSV -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exportar_csv"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Descargar Dataset CSV Completo"
            android:textAllCaps="false"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
