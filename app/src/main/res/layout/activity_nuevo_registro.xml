<?xml version="1.0" encoding="utf-8"?>
<!-- ==========================================================
     ECOLIM MÓVIL - NUEVO REGISTRO & CÁMARA (activity_nuevo_registro.xml)
     HUD de Visor de Escaneo, Chips de Material, Tara y Botones Rápidos
     ========================================================== -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ecolim_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar Superior -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_nuevo"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Nuevo Pesaje de Campo"
            app:titleTextColor="@color/ecolim_primary_dark"
            app:navigationIcon="@drawable/ic_arrow_back" />

        <!-- Visor de Cámara CameraX HUD -->
        <FrameLayout
            android:id="@+id/fl_camera_container"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/black">

            <!-- Camera Preview View -->
            <androidx.camera.view.PreviewView
                android:id="@+id/camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Retícula de Escaneo Verde Láser -->
            <View
                android:layout_width="240dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_scanner_crosshair" />

            <View
                android:id="@+id/laser_line"
                android:layout_width="220dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:background="@color/ecolim_accent_mint" />

            <!-- Botones Superpuestos de Linterna y Cámara -->
            <ImageButton
                android:id="@+id/btn_toggle_torch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_circle_translucent"
                android:src="@drawable/ic_flashlight"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_detected_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Detectado: C-04 (Plástico PET)"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- Formulario de Pesaje y Categoría -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIPO DE MATERIAL RESIDUO"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ecolim_text_muted" />

            <!-- Chips de Categoría -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_materiales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_plastico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plástico"
                        android:checked="true"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_carton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cartón"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_vidrio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vidrio"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_metal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Metal"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_organico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orgánico"
                        style="@style/Widget.Material3.Chip.Filter" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Entrada de Peso Numérico y Tara -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="LECTURA DE BÁSCULA DIGITAL (KG)"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ecolim_text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:suffixText="kg">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_peso_manual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="14.80"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tarar_cero"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:text="Tara 0"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Botones de Incremento Rápido -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_inc_05"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="+0.5"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_inc_10"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="+1.0"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_inc_50"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="+5.0"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_inc_100"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="+10"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Botones Finales Guardar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guardar_registro"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:text="Guardar en SQLite Local"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="14dp"
                android:backgroundTint="@color/ecolim_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guardar_otro"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Guardar y Escanear Siguiente"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
